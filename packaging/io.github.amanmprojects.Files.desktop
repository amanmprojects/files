[Desktop Entry]
Type=Application
Name=Files
GenericName=File Explorer
Comment=Browse folders, archives and SSH servers; copy between them with scp
Icon=io.github.amanmprojects.Files
Exec=files %U
Terminal=false
StartupNotify=true
StartupWMClass=io.github.amanmprojects.Files
Categories=System;FileTools;FileManager;Utility;
Keywords=folder;explorer;file manager;ssh;scp;sftp;remote;archive;
MimeType=inode/directory;application/x-gnome-saved-search;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=files --new-instance
